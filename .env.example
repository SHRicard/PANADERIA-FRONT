# Copiá este archivo a .env (el .env no se sube a Git).
# Las variables EXPO_PUBLIC_* quedan adentro de la app y cualquiera las puede leer: nunca pongas secretos acá.

# URL del back, sin "/" al final.
# En desarrollo alcanza con localhost: ./run.sh android redirige el puerto 3000 del celular a tu compu.
# Para la APK de release y la web publicada, la URL de Render (https://….onrender.com).
EXPO_PUBLIC_API_URL=http://localhost:3000

# Link directo al WhatsApp del dueño, para que el cliente coordine la seña en efectivo después del pedido.
# Ej.: https://wa.me/5491155551234 (sin el +, sin espacios). Vacío, la web no muestra el botón.
EXPO_PUBLIC_WHATSAPP_URL=Https://wa.me/541153271408

# La web pública (https://…, sin "/" al final): va como link al final de cada promo que se comparte en el estado de
# WhatsApp. Vacío, se comparte solo el texto de la promo.
EXPO_PUBLIC_WEB_URL=
